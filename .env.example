# AdLift config. Copy to .env and fill what you have.
# NOTHING here is required to run the demo: if CF keys are absent locally,
# the server falls back to the shared workspace env (telegram-digest/.env),
# and image gen falls back to Pollinations (free, no key).

# --- Default provider: Cloudflare Workers AI (text + image, one token) ---
# Needs a token with the "Workers AI" permission.
CF_ACCOUNT_ID=
CF_AI_TOKEN=

# --- Optional sponsor keys (quality bump + hackathon bonus points) ---
# If set, these OVERRIDE the Cloudflare defaults.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Tavily powers the "research the product" step. Without it the agent
# expands the brief from the LLM instead.
TAVILY_API_KEY=

# --- Model overrides (optional) ---
# LLM_PROVIDER=cf | openai | anthropic   (auto-detected from keys if unset)
# CF_TEXT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-sonnet-4-6

PORT=5050
